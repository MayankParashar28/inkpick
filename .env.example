# Copy to .env for local development (never commit .env)

# TMDB API key — enables posters, overviews and trailers for all ~87k movies.
# Without it, only the ~3,100 titles in models/metadata_cache.json have posters.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Spotify app credentials — live new-release songs and search.
# Create an app at https://developer.spotify.com/dashboard
# Note: Spotify requires the app OWNER's account to have Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=IN

# Optional: protects POST /api/v1/metadata/cache
INTERNAL_SECRET_TOKEN=

# Optional: hybrid blend weight (1.0 = content only, 0.0 = collaborative only)
INKPICK_HYBRID_ALPHA=0.65
